<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.quick.language.switcher</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='languages_setting_container']" position="inside">
                <setting
                    id="quick_language_switcher_setting"
                    string="Quick Language Switcher"
                    help="Choose which languages the navbar switcher offers. Leave empty to offer every active language."
                >
                    <field name="quick_language_allowed_lang_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
